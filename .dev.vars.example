# Copy to .dev.vars for local wrangler/vite (never commit .dev.vars).
# These two lines are local only. They are not uploaded by `wrangler deploy`.
# Production ingest is controlled by wrangler.jsonc.

CRON_SECRET=change-me-local-only
SEATDATA_API_KEY=
APIFY_TOKEN=
INGEST_ENABLED=false
DRY_RUN=true
# SOURCES=seatdata,apify
# APIFY_INCLUDE_LISTINGS=false
