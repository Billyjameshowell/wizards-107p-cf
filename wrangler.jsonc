/**
 * Official C3 React + Vite + Workers config, plus D1/KV, cron, and SAFE flags.
 * https://developers.cloudflare.com/workers/framework-guides/web-apps/react/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wizards-107p-cf",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-11",
	"assets": {
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"triggers": {
		"crons": ["0 12 * * *"]
	},
	"vars": {
		"INGEST_ENABLED": "true",
		"DRY_RUN": "false",
		"SOURCES": "seatdata,apify",
		"APIFY_INCLUDE_LISTINGS": "false",
		"SEATDATA_BASE_URL": "https://seatdata.io/api",
		"SEATDATA_MAX_PULLS_PER_RUN": "20",
		"SEATDATA_MAX_PULLS_PER_ET_DAY": "25",
		"APIFY_MAX_TOTAL_CHARGE_USD": "0.50",
		"APIFY_MAX_EVENTS": "50"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wizards-107p",
			"database_id": "654e066d-0f31-43a2-9856-c35fea9faf3b",
			"migrations_dir": "migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "BOOK",
			"id": "55280961d31940b692a03636f8ebb901"
		}
	]
}
